// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopSettings {
  id           String   @id @default(cuid())
  shop         String   @unique
  settleInDays Int      @default(3)
  sendHour     Int      @default(10)          // 0-23
  clockSource  String   @default("customer")  // "customer" | "store"
  quietDays    Int[]    @default([0])         // 0=Sun ... 6=Sat
  timezone     String   @default("Asia/Kolkata")
  noTracking   String   @default("fixed")     // "fixed" | "skip"
  noTrackDays  Int      @default(7)
  updatedAt    DateTime @updatedAt
}

model SuppressionSettings {
  id                    String   @id @default(cuid())
  shop                  String   @unique
  refundedCancelled     Boolean  @default(true)
  deliveryFailed        Boolean  @default(true)
  openSupportTicket     Boolean  @default(false)
  unsubscribed          Boolean  @default(true)
  alreadyReviewed       Boolean  @default(false)
  cooldownEnabled       Boolean  @default(true)
  cooldownDays          Int      @default(10)
  excludedTags          String[] @default(["wholesale"])
  excludedProductTypes  String[] @default(["Digital"])
  updatedAt             DateTime @updatedAt
}

model Order {
  id                  String    @id            // Shopify order GID
  shop                String
  name                String                    // #1001
  customerName        String?
  customerId          String? 
  customerTags        String[]  @default([])
  productTypes        String[]  @default([])
  totalPrice          Int       @default(0)
  fulfilledAt         DateTime?
  trackingNumber      String?
  deliveredAt         DateTime?
  estimatedDeliveryAt DateTime?
  cancelledAt         DateTime?
  refundedAt          DateTime?
  deliveryFailed      Boolean   @default(false)
  unsubscribed        Boolean   @default(false)
  sentAt              DateTime?
  skippedByYou        Boolean   @default(false)
  customerTimezone    String?       // NEW
  createdAt           DateTime  @default(now())

  @@index([shop])
  @@index([customerId])
  @@index([shop, customerId])
}